# Copy to .env and replace placeholders: cp .env.example .env
# Optional until Gmail OAuth completes: GMAIL_ACCESS_TOKEN, GMAIL_REFRESH_TOKEN

DATABASE_URL=postgresql://reachiq:reachiq@localhost:5432/reachiq
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
CANDIDATE_NAME=Your Full Name
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+15555550123
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
